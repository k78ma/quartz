{
  "name": "obsidian-flashcard-callouts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --noEmit && node build.mjs",
    "test": "node --import tsx --test src/*.test.ts",
    "check": "tsc --noEmit && npm test && prettier . --check",
    "format": "prettier . --write",
    "install:vault": "npm run build && node install.mjs"
  },
  "dependencies": {
    "remark-frontmatter": "^5.0.0",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "obsidian": "^1.8.7",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
